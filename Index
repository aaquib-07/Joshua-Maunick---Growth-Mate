  // ── Data ──
  var TOTAL_CALLS = 418;
  var CONNECTED = 96;
  var CALLBACKS = 2;
  var APPOINTMENTS = 7;
  var CONNECTED_PCT = ((CONNECTED / TOTAL_CALLS) * 100).toFixed(2);
  var APPT_PCT = ((APPOINTMENTS / CONNECTED) * 100).toFixed(2);
 
  var kpis = [
    {
      value: TOTAL_CALLS.toLocaleString(),
      title: 'Total Calls Taken',
      desc: 'Total outbound calls placed this week across all campaigns',
      accent: 'violet',
      icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>'
    },
    {
      value: CONNECTED.toLocaleString(),
      title: 'Calls Connected',
      desc: 'Calls that reached a live prospect and engaged in conversation',
      accent: 'teal',
      icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>'
    },
    {
      value: CONNECTED_PCT + '%',
      title: 'Connected Calls %',
      desc: 'Proportion of total calls that resulted in a live connection',
      accent: 'mint',
      icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>'
    },
    {
      value: CALLBACKS.toLocaleString(),
      title: 'Total Callbacks',
      desc: 'Prospects who requested a follow-up call at a later time',
      accent: 'amber',
      icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>'
    },
    {
      value: APPOINTMENTS.toLocaleString(),
      title: 'Appointments Set',
      desc: 'Confirmed meetings booked with qualified prospects this week',
      accent: 'violet',
      icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>'
    },
    {
      value: APPT_PCT + '%',
      title: 'Appointment %',
      desc: 'Conversion rate from connected calls to confirmed appointments',
      accent: 'rose',
      icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>'
    }
  ];
 
  // ── Render KPIs ──
  var grid = document.getElementById('kpi-grid');
  kpis.forEach(function(k) {
    var card = document.createElement('div');
    card.className = 'kpi-card';
    card.setAttribute('data-accent', k.accent);
    card.innerHTML =
      '<div class="kpi-icon" data-color="' + k.accent + '">' + k.icon + '</div>' +
      '<div class="kpi-value">' + k.value + '</div>' +
      '<div class="kpi-title">' + k.title + '</div>' +
      '<div class="kpi-desc">' + k.desc + '</div>';
    grid.appendChild(card);
  });
 
  // ── Insights ──
  var insights = [
    {
      title: 'Strong Outreach Activity',
      desc: 'Consistent call volume is driving steady top-of-funnel engagement and creating a reliable outreach pipeline.',
      tone: 'teal',
      icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>'
    },
    {
      title: 'Healthy Connection Rate',
      desc: 'The current connection rate reflects effective targeting and improved prospect engagement quality.',
      tone: 'mint',
      icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>'
    },
    {
      title: 'Qualified Conversations Building Momentum',
      desc: 'Connected calls are translating into meaningful conversations, supporting higher intent interactions.',
      tone: 'violet',
      icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>'
    },
    {
      title: 'Appointment Flow Established',
      desc: 'The campaign is successfully converting conversations into scheduled appointments, contributing to pipeline growth.',
      tone: 'teal',
      icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>'
    },
    {
      title: 'Scalable Opportunity Ahead',
      desc: 'With current performance trends, the campaign shows strong potential for scaling outreach and increasing booked meetings.',
      tone: 'amber',
      icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>'
    }
  ];
 
  var insightsList = document.getElementById('insights-list');
  insights.forEach(function(ins) {
    var row = document.createElement('div');
    row.className = 'insight-row';
    row.innerHTML =
      '<div class="insight-icon-wrap" data-tone="' + ins.tone + '">' + ins.icon + '</div>' +
      '<div class="insight-body">' +
        '<div class="insight-title">' + ins.title + '</div>' +
        '<div class="insight-desc">' + ins.desc + '</div>' +
      '</div>';
    insightsList.appendChild(row);
  });
 
  // ── Date ──
  var now = new Date();
  var opts = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
  document.getElementById('report-date').insertAdjacentText('beforeend', ' ' + now.toLocaleDateString('en-AU', opts));
  document.getElementById('header-date-short').textContent = now.toLocaleDateString('en-AU', { day: '2-digit', month: 'short', year: 'numeric' });
 
  // ── Intro ──
  var overlay = document.getElementById('intro-overlay');
  var dash = document.getElementById('dashboard');
  var dismissed = false;
 
  function dismissIntro() {
    if (dismissed) return;
    dismissed = true;
    overlay.classList.add('fade-out');
    dash.classList.add('visible');
    setTimeout(function() {
      overlay.style.display = 'none';
    }, 700);
  }
 
  document.getElementById('skip-btn').addEventListener('click', dismissIntro);
  setTimeout(dismissIntro, 3200);
})();
</script>
